# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region only (not a full URL). The S3 endpoint is built as
# https://s3.<B2_REGION>.backblazeb2.com — find it in your bucket's Endpoint.
B2_REGION=your_region

# Optional — base URL for building public object links (public buckets only).
# The app runs fine without it; image rendering falls back to presigned URLs.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# Where to find each value in the Backblaze B2 console (illustrative, NOT real keys):
#   B2_APPLICATION_KEY_ID  -> the "keyID" shown when you create an application key
#   B2_APPLICATION_KEY     -> the "applicationKey" (shown once, at creation time)
#   B2_BUCKET_NAME         -> your bucket's unique name, e.g. my-training-datasets
#   B2_REGION              -> the region in the bucket's Endpoint, e.g. us-west-004

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
